{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "cd ranu-snookers/backend; $env:COOKIE_SECURE='false'; $env:REDIS_URL=''; $env:RUN_EMBEDDED_WORKER='true'; $env:CORS_ORIGINS='http://localhost:5173'; .\\venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "ranu-snookers/frontend", "run", "dev"],
      "port": 5173
    }
  ]
}
